# Copy to .env for local use (npm start does not load it automatically: node --env-file=.env server.js)
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty in development for a temporary one (2FA secrets and the activity chain then break on restart).
APP_SECRET=
DB_DRIVER=sqlite
SQLITE_PATH=data/loki-auth.db
TURSO_URL=
TURSO_TOKEN=
DEMO_TTL_MS=1800000
# none | resend | file (development only: writes emails to OUTBOX_PATH)
EMAIL_PROVIDER=none
EMAIL_FROM=
RESEND_API_KEY=
OUTBOX_PATH=data/outbox.log
